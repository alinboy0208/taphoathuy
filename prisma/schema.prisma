generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  category    String
  costPrice   Int
  price       Int
  imageUrl    String?
  isActive    Boolean     @default(true)
  orderItems  OrderItem[]
}

model Order {
  id           String      @id @default(cuid())
  customerName String
  phone        String
  address      String
  note         String?
  totalAmount  Int
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int
  costPrice Int

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}
